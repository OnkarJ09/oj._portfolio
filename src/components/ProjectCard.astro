---
interface Props {
  title: string;
  description: string;
  category: string;
  link: string;
  imageSrc: string;
  status?: string;
  reveal?: boolean;
}

const {
  title,
  description,
  category,
  link,
  imageSrc,
  status = "COMPLETED",
  reveal = false
} = Astro.props;
---

<div
  onclick={`window.open('${link}', '_blank', 'noopener,noreferrer')`}
  class={`project-card cursor-pointer relative w-full border border-zinc-800 bg-[#07070b] backdrop-blur-md rounded-sm overflow-hidden group transition-all duration-500 font-['Chakra_Petch',sans-serif]${reveal ? ' project-card--reveal' : ''}`}
>
  <!-- Cyber Corner Tech Brackets (scroll-activated outline in reveal mode, hover otherwise) -->
  <span class="pcorner pcorner-tl"></span>
  <span class="pcorner pcorner-tr"></span>
  <span class="pcorner pcorner-bl"></span>
  <span class="pcorner pcorner-br"></span>

  <!-- Left Edge Glowing Cyber Tab Indicator -->
  <span class="ptab"></span>

  <!-- Image Frame -->
  <div class="relative w-full aspect-[4/3] overflow-hidden border-b border-zinc-800/30">
    <div class="absolute inset-0 pointer-events-none bg-scanlines opacity-[0.05] z-10"></div>
    <div class="w-full h-full overflow-hidden">
      <img
        src={imageSrc}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
      />
    </div>

    <!-- Top-Left Corner Code -->
    <div class="pc-status absolute top-3 left-3 z-20 text-[9px] font-mono text-zinc-500">
      [{status}]
    </div>

    <!-- Bottom-Left Category -->
    <div class="pc-cat absolute bottom-3 left-3 z-20 px-2.5 py-0.5 rounded bg-zinc-950/80 border border-zinc-800/80 text-[8px] font-bold tracking-widest text-zinc-400">
      {category}
    </div>
  </div>

  <!-- Content Section -->
  <div class="p-6 relative">
    <!-- Corner Markers -->
    <div class="pc-mark absolute top-0 left-0 w-2 h-2 border-t border-l border-zinc-800 pointer-events-none"></div>
    <div class="pc-mark absolute top-0 right-0 w-2 h-2 border-t border-r border-zinc-800 pointer-events-none"></div>

    <div class="flex items-center justify-between gap-4">
      <h3 class="pc-title font-['Orbitron',sans-serif] font-bold text-sm md:text-base text-white tracking-wide">
        {title}
      </h3>
      <span class="text-[10px] font-bold tracking-widest text-zinc-500 group-hover:text-white transition-colors flex items-center gap-1">
        VISIT
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </span>
    </div>

    <p class="text-zinc-550 text-xs mt-3 leading-relaxed tracking-wide font-normal max-w-sm">
      {description}
    </p>
  </div>
</div>

<style>
  .bg-scanlines {
    background: linear-gradient(
      rgba(18, 16, 16, 0) 50%,
      rgba(0, 0, 0, 0.25) 50%
    );
    background-size: 100% 4px;
  }

  /* Base dark drop shadow (replaces the old Tailwind shadow utility) */
  .project-card {
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.7);
  }

  /* Reveal cards honor the per-card stagger delay */
  .project-card--reveal {
    transition-delay: var(--reveal-delay, 0ms);
  }

  /* ---- Border + glow activation ---- */
  /* Default cards: hover (matches the prior hover behaviour) */
  .project-card:not(.project-card--reveal):hover {
    border-color: rgba(249, 115, 22, 0.35);
    box-shadow: 0 0 20px rgba(249, 115, 22, 0.15);
  }
  /* Reveal cards: scroll only (keeps the drop shadow + adds the glow) */
  .project-card--reveal.is-visible {
    border-color: rgba(249, 115, 22, 0.35);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.7), 0 0 20px rgba(249, 115, 22, 0.15);
  }

  /* ---- Cyber corner brackets ---- */
  .project-card .pcorner {
    position: absolute;
    width: 12px;
    height: 12px;
    pointer-events: none;
    z-index: 30;
    opacity: 0;
    transform: scale(0.2);
    transition: transform 0.5s cubic-bezier(0.2, 0.65, 0.3, 0.9), opacity 0.45s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .pcorner-tl {
    top: 0; left: 0;
    border-top: 1.5px solid rgba(249, 115, 22, 0.65);
    border-left: 1.5px solid rgba(249, 115, 22, 0.65);
    transform-origin: top left;
  }
  .pcorner-tr {
    top: 0; right: 0;
    border-top: 1.5px solid rgba(249, 115, 22, 0.65);
    border-right: 1.5px solid rgba(249, 115, 22, 0.65);
    transform-origin: top right;
  }
  .pcorner-bl {
    bottom: 0; left: 0;
    border-bottom: 1.5px solid rgba(249, 115, 22, 0.65);
    border-left: 1.5px solid rgba(249, 115, 22, 0.65);
    transform-origin: bottom left;
  }
  .pcorner-br {
    bottom: 0; right: 0;
    border-bottom: 1.5px solid rgba(249, 115, 22, 0.65);
    border-right: 1.5px solid rgba(249, 115, 22, 0.65);
    transform-origin: bottom right;
  }
  .project-card:not(.project-card--reveal):hover .pcorner,
  .project-card--reveal.is-visible .pcorner {
    opacity: 1;
    transform: scale(1);
  }

  /* ---- Left edge glowing tab ---- */
  .project-card .ptab {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1.5px;
    height: 0;
    background: #f97316;
    pointer-events: none;
    z-index: 30;
    opacity: 0;
    transition: height 0.35s ease, opacity 0.35s ease;
    transition-delay: calc(var(--reveal-delay, 0ms) + 120ms);
  }
  .project-card:not(.project-card--reveal):hover .ptab,
  .project-card--reveal.is-visible .ptab {
    height: 3rem;
    opacity: 1;
  }

  /* ---- Text + inner-marker light-up ---- */
  .pc-title,
  .pc-status,
  .pc-cat,
  .pc-mark {
    transition: color 0.4s ease, border-color 0.4s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .project-card:not(.project-card--reveal):hover .pc-title,
  .project-card--reveal.is-visible .pc-title {
    color: #fb923c;
  }
  .project-card:not(.project-card--reveal):hover .pc-status,
  .project-card--reveal.is-visible .pc-status {
    color: #fb923c;
  }
  .project-card:not(.project-card--reveal):hover .pc-cat,
  .project-card--reveal.is-visible .pc-cat {
    border-color: rgba(249, 115, 22, 0.3);
    color: #fb923c;
  }
  .project-card:not(.project-card--reveal):hover .pc-mark,
  .project-card--reveal.is-visible .pc-mark {
    border-color: rgba(249, 115, 22, 0.3);
  }
</style>

<script>
  function initProjectCardReveal() {
    const cards = document.querySelectorAll<HTMLElement>(".project-card--reveal");
    if (!cards.length) return;

    // Graceful fallback if IntersectionObserver is unavailable
    if (!("IntersectionObserver" in window)) {
      cards.forEach((c) => c.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            // One-shot reveal: stay highlighted once activated
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35, rootMargin: "0px 0px -8% 0px" }
    );

    cards.forEach((c) => observer.observe(c));
  }

  // Run on page load and astro page swap transitions
  initProjectCardReveal();
  document.addEventListener("astro:after-swap", initProjectCardReveal);
</script>
