---
interface FAQ {
  num: string;
  question: string;
  answer: string;
}

const faqs: FAQ[] = [
  {
    num: "01",
    question: "What technical domains do you specialize in?",
    answer: "I specialize in Artificial Intelligence (LLMs, Retrieval-Augmented Generation/RAG, Agentic AI), VLSI Design & Technology (ML applications for diagnostics), Full-Stack Web Development (Astro, React, FastAPI), and System Automation scripting (Python CLI tools)."
  },
  {
    num: "02",
    question: "What is your work in VLSI Design & Technology?",
    answer: "My focus is bridging hardware engineering with AI. This includes developing systems like the VLSI Fault Detection Assistant to automate diagnostics, optimize testing, and analyze semiconductor telemetry data."
  },
  {
    num: "03",
    question: "How do you construct your AI and RAG solutions?",
    answer: "I build modular data pipelines using Python, LangChain, and vector stores. I configure both local offline models (e.g., Qwen 2.5 via Ollama) for privacy and zero-latency, and cloud API LLMs for complex reasoning."
  },
  {
    num: "04",
    question: "What is your preferred stack for web development?",
    answer: "I build fast, high-performance web systems using Astro for frontend architecture (maximizing SEO and load times), React for dynamic interactive components, and FastAPI/Python for robust backend services."
  },
  {
    num: "05",
    question: "What kind of workflow automation projects do you build?",
    answer: "I write custom command-line interfaces (CLI tools), system monitoring scripts, and data pipeline managers in Python to automate repetitive development processes, sync databases, or configure APIs."
  },
  {
    num: "06",
    question: "Are your projects open source?",
    answer: "Yes. Most of my active automation utilities, templates, and systems are open source and hosted on my GitHub. The codebases are licensed under the Apache License 2.0 for free use and modifications."
  },
  {
    num: "07",
    question: "Are you available for internships or collaborations?",
    answer: "Absolutely. I am available for select technical collaborations, research projects, and internships. You can send a signal via the Contact page or email me directly at onkar.joshi2105@gmail.com."
  }
];
---

<div class="faq-accordion w-full flex flex-col gap-4 font-['Chakra_Petch',sans-serif]">
  {faqs.map((faq) => (
    <details class="group border border-zinc-800 bg-[#07070b] hover:border-orange-500/20 rounded-lg shadow-[0_4px_16px_rgba(0,0,0,0.5)] transition-all duration-300">
      <summary class="flex items-center justify-between p-5 md:p-6 cursor-pointer select-none focus:outline-none list-none [&::-webkit-details-marker]:hidden">
        <div class="flex items-center gap-4">
          <span class="text-[10px] font-mono text-zinc-550 group-open:text-orange-400">{faq.num}</span>
          <span class="text-xs md:text-sm font-semibold tracking-wide text-zinc-350 group-hover:text-white transition-colors">{faq.question}</span>
        </div>
        <div class="relative w-4 h-4 flex items-center justify-center text-zinc-500 group-hover:text-white transition-colors">
          <!-- Horizontal line -->
          <span class="absolute w-3.5 h-px bg-current"></span>
          <!-- Vertical line (rotates to 0 on open) -->
          <span class="absolute h-3.5 w-px bg-current transition-transform duration-300 group-open:rotate-90"></span>
        </div>
      </summary>
      
      <div class="px-5 pb-5 md:px-6 md:pb-6 border-t border-zinc-800/20 mt-[-1px] transition-all duration-300">
        <p class="text-zinc-550 text-xs leading-relaxed tracking-wide font-normal pt-4 max-w-2xl">
          {faq.answer}
        </p>
      </div>
    </details>
  ))}
</div>
