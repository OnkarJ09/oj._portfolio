---
---

<footer class="w-full border-t border-zinc-800/10 bg-[#121218]/30 font-['Chakra_Petch',sans-serif] mt-auto">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    <!-- Huge Call To Action -->
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 pb-12 md:pb-16 border-b border-zinc-800/20">
      <div>
        <h2 class="font-['Orbitron',sans-serif] text-2xl md:text-3xl font-extrabold tracking-wider text-white">LET'S CONNECT</h2>
        <p class="text-zinc-500 text-xs md:text-sm tracking-wide mt-2.5 max-w-md leading-relaxed">
          I'm currently available for select projects and collaborations. Let's create digital experiences that leave a lasting impact.
        </p>
      </div>
      
      <a 
        href="/contact" 
        class="inline-flex items-center gap-3 px-6 py-3.5 border border-orange-500/20 hover:border-orange-500/60 bg-orange-500/5 hover:bg-orange-500/10 text-orange-400 hover:text-white rounded-md text-xs font-semibold tracking-[0.2em] transition-all duration-300"
      >
        SEND A SIGNAL
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- Info Column / Links -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 pt-12 md:pt-16 text-zinc-500 text-[11px] tracking-widest">
      
      <!-- Signature -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-2 select-none">
          <span class="w-1.5 h-1.5 bg-orange-500 rounded-full"></span>
          <span class="font-['Orbitron',sans-serif] font-bold text-sm tracking-widest text-white">ONKAR JOSHI</span>
        </div>
        <p class="text-zinc-650 tracking-normal leading-relaxed text-[11px] max-w-[220px]">
          Futuristic digital portfolios built with extreme focus on structure, typography, and clean interactions.
        </p>
      </div>

      <!-- Sitemap Links -->
      <div class="flex flex-col gap-3">
        <span class="text-zinc-400 font-semibold mb-1 select-none">MAP DIRECTIONS</span>
        <a href="/" class="hover:text-white transition-colors duration-300">HOME</a>
        <a href="/works" class="hover:text-white transition-colors duration-300">SELECTED WORKS</a>
        <a href="/about" class="hover:text-white transition-colors duration-300">ABOUT PROFILE</a>
        <a href="/contact" class="hover:text-white transition-colors duration-300">GET IN TOUCH</a>
      </div>

      <!-- Social / Technical Links -->
      <div class="flex flex-col gap-3">
        <span class="text-zinc-400 font-semibold mb-1 select-none">EXTERNAL CHANNELS</span>
        <a href="https://www.linkedin.com/in/onkar-joshi2109/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-300">LINKEDIN</a>
        <a href="https://github.com/OnkarJ09" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-300">GITHUB</a>
        <div class="text-[10px] text-zinc-650 tracking-wider mt-4">
          © {new Date().getFullYear()} ONKAR JOSHI. ALL RIGHTS RESERVED.
        </div>
      </div>

    </div>
  </div>
</footer>
