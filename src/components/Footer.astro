---
---

<footer class="w-full border-t border-zinc-800 bg-[#07070b] font-['Chakra_Petch',sans-serif] mt-auto relative overflow-hidden z-10 pointer-events-auto">
  <!-- Top glow accent bar -->
  <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-orange-500/25 to-transparent"></div>

  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
    <!-- Huge Call To Action -->
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 pb-12 border-b border-zinc-850">
      <div>
        <h2 class="font-['Orbitron',sans-serif] text-xl md:text-2xl font-black tracking-widest text-white">LET'S CONNECT</h2>
        <p class="text-zinc-300 text-sm md:text-[16px] tracking-wide mt-2.5 max-w-md leading-relaxed font-semibold">
          I'm currently available for select projects and collaborations. Let's build digital systems that make an impact.
        </p>
      </div>
      
      <a 
        href="/contact" 
        class="inline-flex items-center gap-3 px-6 py-3.5 border border-orange-500/25 hover:border-orange-500/60 bg-orange-500/5 hover:bg-orange-500/10 text-orange-400 hover:text-white rounded-sm text-sm font-bold tracking-[0.2em] transition-all duration-300"
      >
        SEND A SIGNAL
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- Info Column / Links -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pt-12 text-zinc-500 text-[11px] tracking-widest">
      
      <!-- Signature -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-2 select-none">
          <span class="w-1.5 h-1.5 bg-orange-500 rounded-full animate-pulse"></span>
          <span class="font-['Orbitron',sans-serif] font-bold text-sm tracking-widest text-white">ONKAR JOSHI</span>
        </div>
        <p class="text-zinc-400 tracking-normal leading-relaxed text-[11px] max-w-[220px] font-semibold">
          Intelligent software solutions & high-tech digital systems. Specializing in Python, AI (LLMs/RAG), and VLSI.
        </p>
      </div>

      <!-- Quick Directory -->
      <div class="flex flex-col gap-3">
        <span class="text-zinc-350 font-bold mb-1 select-none font-mono text-[10px]">MAP DIRECTORY</span>
        <a href="/" class="hover:text-white transition-colors duration-300">HOME</a>
        <a href="/works" class="hover:text-white transition-colors duration-300">SELECTED WORKS</a>
        <a href="/about" class="hover:text-white transition-colors duration-300">ABOUT PROFILE</a>
        <a href="/contact" class="hover:text-white transition-colors duration-300">GET IN TOUCH</a>
      </div>

      <!-- Contact Info -->
      <div class="flex flex-col gap-3">
        <span class="text-zinc-350 font-bold mb-1 select-none font-mono text-[10px]">COMMUNICATION</span>
        <a href="mailto:onkar.joshi2105@gmail.com" class="hover:text-white transition-colors duration-300 lowercase text-[12px] tracking-normal font-mono font-semibold">onkar.joshi2105@gmail.com</a>
        <span class="text-zinc-400 select-none text-[12px] font-mono font-semibold">NAGPUR, INDIA</span>
        
        <!-- Live System Check status bar -->
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[#0d0d12] border border-zinc-800 w-fit mt-2 select-none font-mono text-[11px] text-emerald-400 font-bold">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping"></span>
          SYS_STATUS: ONLINE
        </div>
      </div>

      <!-- Social / Technical Links -->
      <div class="flex flex-col gap-3">
        <span class="text-zinc-350 font-bold mb-1 select-none font-mono text-[10px]">EXTERNAL CHANNELS</span>
        <a href="https://www.linkedin.com/in/onkar-joshi2109/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-300">LINKEDIN</a>
        <a href="https://github.com/OnkarJ09" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-300">GITHUB</a>
        
        <div class="text-[12px] text-zinc-500 tracking-wider mt-4 font-mono flex flex-col gap-1 font-semibold">
          <div>© {new Date().getFullYear()} ONKAR JOSHI.</div>
          <div class="text-[11px] text-zinc-500">LICENSED UNDER APACHE 2.0</div>
        </div>
      </div>

    </div>
  </div>
</footer>
