---
interface Props {
  src?: string;
  alt?: string;
}

const { src = "/me2.png", alt = "Interactive Halftone Portrait" } = Astro.props;
---

<div class="interactive-photo-container relative w-full aspect-[1882/1979] overflow-visible bg-transparent group">
  <!-- Interactive Particle Canvas -->
  <div class="relative w-full h-full flex items-center justify-center bg-transparent">
    <canvas 
      id="pixel-particle-canvas" 
      data-src={src} 
      class="w-full h-full transition-opacity duration-500 opacity-0"
      style="mask-image: linear-gradient(to bottom, black 65%, transparent 95%); -webkit-mask-image: linear-gradient(to bottom, black 65%, transparent 95%);"
    ></canvas>
    
    <!-- Loading indicator -->
    <div id="canvas-loader" class="absolute inset-0 flex items-center justify-center text-zinc-700 text-[10px] tracking-[0.25em] font-mono animate-pulse">
      SYS: HALFTONE_INIT...
    </div>
  </div>
</div>

<script>
  class Particle {
    x: number;
    y: number;
    originX: number;
    originY: number;
    gray: number;
    size: number;
    vx: number;
    vy: number;
    ease: number;
    friction: number;
    active: boolean;
    blendRatio: number;

    constructor(x: number, y: number, gray: number, size: number) {
      this.originX = x;
      this.originY = y;
      this.x = x;
      this.y = y;
      this.gray = gray;
      this.size = size;
      this.vx = 0;
      this.vy = 0;
      this.ease = 0.12 + Math.random() * 0.04;
      this.friction = 0.82;
      this.active = true;
      this.blendRatio = 0;
    }

    update(mouseX: number, mouseY: number, isHovered: boolean) {
      if (!isHovered && Math.abs(this.vx) < 0.005 && Math.abs(this.vy) < 0.005 && Math.abs(this.x - this.originX) < 0.05 && Math.abs(this.y - this.originY) < 0.05) {
        this.x = this.originX;
        this.y = this.originY;
        this.vx = 0;
        this.vy = 0;
        this.blendRatio = 0;
        this.active = false;
        return;
      }

      this.active = true;

      const dx = this.originX - this.x;
      const dy = this.originY - this.y;
      this.vx += dx * this.ease;
      this.vy += dy * this.ease;

      if (isHovered) {
        const mdx = this.x - mouseX;
        const mdy = this.y - mouseY;
        const dist = Math.sqrt(mdx * mdx + mdy * mdy);
        const radius = 55;
        
        if (dist < radius) {
          const force = (radius - dist) / radius;
          const angle = Math.atan2(mdy, mdx);
          const push = force * 4.2;
          this.vx += Math.cos(angle) * push;
          this.vy += Math.sin(angle) * push;
          this.blendRatio = force;
        } else {
          this.blendRatio = 0;
        }
      } else {
        this.blendRatio = 0;
      }

      this.vx *= this.friction;
      this.vy *= this.friction;
      this.x += this.vx;
      this.y += this.vy;
    }
  }

  function initPixelCanvas() {
    const canvas = document.getElementById("pixel-particle-canvas") as HTMLCanvasElement | null;
    const loader = document.getElementById("canvas-loader");
    if (!canvas) return;

    const imgSrc = canvas.getAttribute("data-src") || "/me2.png";
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const img = new Image();
    img.src = imgSrc;
    img.crossOrigin = "anonymous";

    img.onload = () => {
      if (loader) loader.style.display = "none";
      canvas.classList.remove("opacity-0");

      const containerWidth = canvas.parentElement?.clientWidth || 372;
      const containerHeight = canvas.parentElement?.clientHeight || 450;
      
      const dpr = window.devicePixelRatio || 1;
      canvas.width = containerWidth * dpr;
      canvas.height = containerHeight * dpr;
      ctx.scale(dpr, dpr);

      const bufferCanvas = document.createElement("canvas");
      const gridWidth = 240; 
      const gridHeight = Math.round(gridWidth * (1979 / 1882)); // Updated to respect me2.png size ratio (1882x1979)
      bufferCanvas.width = gridWidth;
      bufferCanvas.height = gridHeight;
      const bufferCtx = bufferCanvas.getContext("2d");
      if (!bufferCtx) return;

      bufferCtx.drawImage(img, 0, 0, gridWidth, gridHeight);
      const imgData = bufferCtx.getImageData(0, 0, gridWidth, gridHeight);
      const data = imgData.data;

      const particles: Particle[] = [];
      const scaleX = containerWidth / gridWidth;
      const scaleY = containerHeight / gridHeight;
      const particleSize = Math.max(scaleX, scaleY);

      const verticalShift = -22;

      for (let y = 0; y < gridHeight; y++) {
        for (let x = 0; x < gridWidth; x++) {
          const idx = (y * gridWidth + x) * 4;
          const r = data[idx];
          const g = data[idx + 1];
          const b = data[idx + 2];
          const a = data[idx + 3];

          if (a > 30) {
            let gray = 0.299 * r + 0.587 * g + 0.114 * b;
            
            gray = (gray - 80) * 1.6 + 130; 
            gray = Math.max(0, Math.min(255, gray));

            if (gray > 45) {
              particles.push(
                new Particle(
                  x * scaleX + scaleX / 2,
                  y * scaleY + scaleY / 2 + verticalShift,
                  gray,
                  particleSize
                )
              );
            }
          }
        }
      }

      let mouseX = 0;
      let mouseY = 0;
      let isHovered = false;

      const updateMousePos = (e: MouseEvent) => {
        const rect = canvas.getBoundingClientRect();
        mouseX = e.clientX - rect.left;
        mouseY = e.clientY - rect.top;
      };

      canvas.addEventListener("mousemove", (e) => {
        isHovered = true;
        updateMousePos(e);
      });

      canvas.addEventListener("mouseenter", (e) => {
        isHovered = true;
        updateMousePos(e);
      });

      canvas.addEventListener("mouseleave", () => {
        isHovered = false;
      });

      canvas.addEventListener("touchmove", (e) => {
        isHovered = true;
        if (e.touches.length > 0) {
          const rect = canvas.getBoundingClientRect();
          mouseX = e.touches[0].clientX - rect.left;
          mouseY = e.touches[0].top - rect.top;
        }
      }, { passive: true });

      canvas.addEventListener("touchstart", (e) => {
        isHovered = true;
        if (e.touches.length > 0) {
          const rect = canvas.getBoundingClientRect();
          mouseX = e.touches[0].clientX - rect.left;
          mouseY = e.touches[0].top - rect.top;
        }
      }, { passive: true });

      canvas.addEventListener("touchend", () => {
        isHovered = false;
      }, { passive: true });

      const numBuckets = 8;
      
      const animate = () => {
        ctx.clearRect(0, 0, containerWidth, containerHeight);
        
        const grayBuckets: Particle[][] = Array.from({ length: numBuckets }, () => []);
        const hoverBuckets: Particle[][] = Array.from({ length: numBuckets }, () => []);

        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          p.update(mouseX, mouseY, isHovered);
          
          if (p.blendRatio > 0.05) {
            const hIdx = Math.floor(p.blendRatio * (numBuckets - 1));
            hoverBuckets[hIdx].push(p);
          } else {
            const bIdx = Math.floor((p.gray / 255) * (numBuckets - 1));
            grayBuckets[bIdx].push(p);
          }
        }

        for (let b = 0; b < numBuckets; b++) {
          const pList = grayBuckets[b];
          if (pList.length === 0) continue;
          
          const brightness = b / (numBuckets - 1);
          const alpha = 0.35 + brightness * 0.55;
          ctx.fillStyle = `rgba(235, 235, 240, ${alpha})`;
          
          ctx.beginPath();
          for (let i = 0; i < pList.length; i++) {
            const p = pList[i];
            const radius = p.size * 0.28 * (p.gray / 255) * 1.1;
            ctx.rect(p.x - radius, p.y - radius, radius * 2, radius * 2);
          }
          ctx.fill();
        }

        for (let b = 0; b < numBuckets; b++) {
          const pList = hoverBuckets[b];
          if (pList.length === 0) continue;
          
          const blendRatio = b / (numBuckets - 1);
          const nr = Math.round(235 * (1 - blendRatio) + 251 * blendRatio);
          const ng = Math.round(235 * (1 - blendRatio) + 152 * blendRatio);
          const nb = Math.round(240 * (1 - blendRatio) + 40 * blendRatio);
          ctx.fillStyle = `rgba(${nr}, ${ng}, ${nb}, 0.85)`;
          
          ctx.beginPath();
          for (let i = 0; i < pList.length; i++) {
            const p = pList[i];
            const radius = p.size * 0.28 * (p.gray / 255) * 1.1;
            ctx.rect(p.x - radius, p.y - radius, radius * 2, radius * 2);
          }
          ctx.fill();
        }
        
        requestAnimationFrame(animate);
      };
      
      animate();
    };
  }

  document.addEventListener("DOMContentLoaded", initPixelCanvas);
  document.addEventListener("astro:after-swap", initPixelCanvas);
</script>
