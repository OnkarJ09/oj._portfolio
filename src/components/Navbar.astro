---
---

<header class="w-full border-b border-zinc-800/20 bg-[#121218]/40 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between font-['Chakra_Petch',sans-serif]">
    
    <!-- Left Logo -->
    <a href="/" class="flex flex-col select-none">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></span>
        <span class="font-['Orbitron',sans-serif] font-bold text-base tracking-widest text-white uppercase ascii-ripple-text">ONKAR JOSHI</span>
      </div>
      <span id="tagline-glitch" class="text-[12px] font-mono text-orange-500/80 tracking-wider pl-4 ascii-ripple-text">alias: mad_dog</span>
    </a>

    <!-- Navigation Links: Spotlight Navbar -->
    <nav 
      id="spotlight-navbar"
      class="hidden md:flex relative h-10 rounded-full border border-zinc-800/40 bg-zinc-950/40 backdrop-blur-md px-1 items-center overflow-hidden select-none"
      style="--spotlight-color: rgba(249, 115, 22, 0.12); --ambience-color: rgba(249, 115, 22, 1);"
    >
      <ul class="relative flex items-center h-full gap-0.5 z-10">
        <li>
          <a 
            href="/" 
            data-index="0"
            class="nav-item px-4 py-1 text-[11px] font-semibold tracking-[0.18em] rounded-full transition-colors duration-200 text-zinc-400 hover:text-white"
          >
            <span class="ascii-ripple-text">HOME</span>
          </a>
        </li>
        <li>
          <a 
            href="/works" 
            data-index="1"
            class="nav-item px-4 py-1 text-[11px] font-semibold tracking-[0.18em] rounded-full transition-colors duration-200 text-zinc-400 hover:text-white"
          >
            <span class="ascii-ripple-text">WORKS</span>
          </a>
        </li>
        <li>
          <a 
            href="/about" 
            data-index="2"
            class="nav-item px-4 py-1 text-[11px] font-semibold tracking-[0.18em] rounded-full transition-colors duration-200 text-zinc-400 hover:text-white"
          >
            <span class="ascii-ripple-text">ABOUT</span>
          </a>
        </li>
        <li>
          <a 
            href="/contact" 
            data-index="3"
            class="nav-item px-4 py-1 text-[11px] font-semibold tracking-[0.18em] rounded-full transition-colors duration-200 text-zinc-400 hover:text-white"
          >
            <span class="ascii-ripple-text">CONTACT</span>
          </a>
        </li>
      </ul>

      <!-- Spotlight Hover Glow (Follows Mouse) -->
      <div
        id="nav-spotlight"
        class="pointer-events-none absolute inset-0 z-1 opacity-0 transition-opacity duration-300"
        style="background: radial-gradient(80px circle at var(--spotlight-x, 0px) 50%, var(--spotlight-color) 0%, transparent 100%);"
      ></div>

      <!-- Active Ambience Glow Line (Translates smoothly) -->
      <div
        id="nav-ambience-glow"
        class="pointer-events-none absolute bottom-0 left-0 h-[2px] w-[50px] z-2 bg-gradient-to-r from-orange-500 to-amber-400 shadow-[0_0_12px_rgba(249,115,22,0.8)] transition-all duration-300 ease-out"
        style="transform: translateX(0px); opacity: 0;"
      ></div>
    </nav>

    <!-- Tech Status & Clock Widget -->
    <div class="hidden lg:flex items-center gap-6 text-[10px] text-zinc-500 tracking-wider">
      <div class="flex items-center gap-2 border-r border-zinc-850 pr-4">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
        <span class="text-zinc-400 font-medium select-none">OPEN FOR WORK</span>
      </div>
      <div>
        <span class="text-zinc-650">NAGPUR</span>
        <span id="nav-local-clock" class="text-zinc-400 font-mono font-medium ml-1">00:00:00 AM</span>
      </div>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden text-zinc-400 hover:text-white transition-colors duration-300 focus:outline-none">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-dropdown" class="hidden md:hidden border-t border-zinc-850 bg-[#121218]/95 backdrop-blur-lg px-6 py-6 flex flex-col gap-4 font-['Chakra_Petch',sans-serif]">
    <a href="/" class="text-xs font-semibold tracking-widest text-zinc-400 hover:text-white transition-colors">
      <span class="ascii-ripple-text">HOME</span>
    </a>
    <a href="/works" class="text-xs font-semibold tracking-widest text-zinc-400 hover:text-white transition-colors">
      <span class="ascii-ripple-text">WORKS</span>
    </a>
    <a href="/about" class="text-xs font-semibold tracking-widest text-zinc-400 hover:text-white transition-colors">
      <span class="ascii-ripple-text">ABOUT</span>
    </a>
    <a href="/contact" class="text-xs font-semibold tracking-widest text-zinc-400 hover:text-white transition-colors">
      <span class="ascii-ripple-text">CONTACT</span>
    </a>
  </div>
</header>

<script>
  // Dynamic Local Clock Script
  const clockEl = document.getElementById("nav-local-clock");
  if (clockEl) {
    const updateTime = () => {
      const options: Intl.DateTimeFormatOptions = {
        timeZone: 'Asia/Kolkata',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
      };
      clockEl.textContent = new Date().toLocaleTimeString('en-US', options);
    };
    updateTime();
    setInterval(updateTime, 1000);
  }

  // Mobile Menu Toggle handler
  function initMobileMenu() {
    const menuBtn = document.getElementById("mobile-menu-btn");
    const dropdown = document.getElementById("mobile-dropdown");
    if (!menuBtn || !dropdown) return;

    // Clone button to strip existing listeners
    const cleanBtn = menuBtn.cloneNode(true) as HTMLButtonElement;
    menuBtn.replaceWith(cleanBtn);

    cleanBtn.addEventListener("click", () => {
      const isHidden = dropdown.classList.contains("hidden");
      const menuIcon = cleanBtn.querySelector("#menu-icon");
      if (isHidden) {
        dropdown.classList.remove("hidden");
        menuIcon?.setAttribute("d", "M6 18L18 6M6 6l12 12");
      } else {
        dropdown.classList.add("hidden");
        menuIcon?.setAttribute("d", "M4 6h16M4 12h16m-7 6h7");
      }
    });
  }

  // Spotlight Navbar Script
  function initSpotlightNavbar() {
    const nav = document.getElementById("spotlight-navbar");
    const spotlight = document.getElementById("nav-spotlight");
    const activeGlow = document.getElementById("nav-ambience-glow");
    if (!nav) return;

    // 1. Mousemove listener to follow the cursor spotlight
    if (spotlight) {
      nav.addEventListener("mousemove", (e) => {
        const rect = nav.getBoundingClientRect();
        const x = e.clientX - rect.left;
        nav.style.setProperty("--spotlight-x", `${x}px`);
        spotlight.style.opacity = '1';
      });

      nav.addEventListener("mouseleave", () => {
        spotlight.style.opacity = '0';
      });
    }

    // 2. Active indicator alignment
    const updateActiveIndicator = () => {
      const pathname = window.location.pathname;
      let activeIndex = 0;
      if (pathname.includes('/works')) activeIndex = 1;
      else if (pathname.includes('/about')) activeIndex = 2;
      else if (pathname.includes('/contact')) activeIndex = 3;

      const activeItem = nav.querySelector(`[data-index="${activeIndex}"]`);
      if (activeItem && activeGlow) {
        // Highlight current nav item
        nav.querySelectorAll('.nav-item').forEach((item, idx) => {
          if (idx === activeIndex) {
            item.classList.add('text-orange-450', 'bg-orange-500/5');
            item.classList.remove('text-zinc-400');
          } else {
            item.classList.remove('text-orange-450', 'bg-orange-500/5');
            item.classList.add('text-zinc-400');
          }
        });

        const navRect = nav.getBoundingClientRect();
        const itemRect = activeItem.getBoundingClientRect();
        
        activeGlow.style.width = `${itemRect.width}px`;
        activeGlow.style.transform = `translateX(${itemRect.left - navRect.left}px)`;
        activeGlow.style.opacity = '1';
      }
    };

    // Run immediately and after a short timeout to ensure layout rects are correct
    updateActiveIndicator();
    setTimeout(updateActiveIndicator, 50);
  }

  function initTaglineGlitch() {
    const el = document.getElementById("tagline-glitch");
    if (!el) return;

    if ((window as any)._taglineGlitchInterval) {
      clearInterval((window as any)._taglineGlitchInterval);
    }

    const triggerGlitch = () => {
      const rect = el.getBoundingClientRect();
      const x = rect.left + Math.random() * rect.width;
      el.dispatchEvent(new MouseEvent("mouseenter", {
        clientX: x,
        clientY: rect.top + rect.height / 2
      }));
      setTimeout(() => {
        el.dispatchEvent(new MouseEvent("mouseleave"));
      }, 700);
    };

    // Trigger initial glitch after short delay
    setTimeout(triggerGlitch, 1500);

    // Periodic glitch every 3.75 seconds
    (window as any)._taglineGlitchInterval = setInterval(triggerGlitch, 3750);
  }

  // Run on page load and astro page swap transitions
  initMobileMenu();
  initSpotlightNavbar();
  initTaglineGlitch();

  document.addEventListener("astro:after-swap", () => {
    initMobileMenu();
    initSpotlightNavbar();
    initTaglineGlitch();
  });
</script>
