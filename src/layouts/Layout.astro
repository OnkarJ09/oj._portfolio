---
import '../styles/global.css';
import PerspectiveGrid from '../components/PerspectiveGrid.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = "Perspective Grid" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Orbitron:wght@400..900&family=Outfit:wght@100..950&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#121218] text-slate-100 min-h-screen relative overflow-x-hidden font-[Outfit,sans-serif] pointer-events-auto flex flex-col">
    
    <!-- Perspective Grid Background Layer -->
    <div class="fixed inset-0 z-0">
      <PerspectiveGrid gridSize={30} fadeRadius={85} />
    </div>

    <!-- Navigation Header -->
    <Navbar />

    <!-- Layout Slot Content -->
    <div class="relative z-10 flex flex-col flex-1 pointer-events-none">
      <slot />
    </div>

    <!-- Footer -->
    <Footer />
  </body>
</html>
