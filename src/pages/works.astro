    link: "https://github.com/OnkarJ09",
    status: "ACTIVE"
  },
  {
    title: "Qwen 2.5 Chatbot",
    category: "AI CHATBOT",
    type: "ai-ml",
    description: "Local offline conversational AI chatbot powered by the Qwen 2.5 language model running through Ollama and Streamlit.",
    imageSrc: "/codify.png",
    link: "https://github.com/OnkarJ09",
    status: "COMPLETED"
  },
  {
    title: "RAG Prototypes",
    category: "AI RESEARCH",
    type: "ai-ml",
    description: "RAG prototypes exploring document indexing, semantic search, and context-aware QA using FAISS and Hugging Face models.",
    imageSrc: "/ainest.png",
    link: "https://github.com/OnkarJ09",
    status: "COMPLETED"
  },
  {
    title: "Vedas.ai",
    category: "AI ASSISTANT",
    type: "ai-ml",
    description: "Intelligent AI virtual assistant capable of automating everyday tasks using text/voice commands, speech recognition, and TTS.",
    imageSrc: "/brandora.png",
    link: "https://github.com/OnkarJ09",
    status: "ACTIVE"
  },
  {
    title: "All App Opener",
    category: "AUTOMATION TOOL",
    type: "automation",
    description: "Cross-platform Python package that opens, closes, and manages desktop applications using only their names.",
    imageSrc: "/todofusion.png",
    link: "https://github.com/OnkarJ09",
    status: "STABLE"
  },
  {
    title: "Auto Bug Fixer",
    category: "AI UTILITY",
    type: "ai-ml",
    description: "AI-powered terminal utility that identifies, analyzes, and suggests fixes for programming errors across multiple languages.",
    imageSrc: "/snapkit.png",
    link: "https://github.com/OnkarJ09",
    status: "COMPLETED"
  },
  {
    title: "Translator API",
    category: "API DEV",
    type: "web-dev",
    description: "Lightweight translation API that provides multilingual translation functionality simple to integrate into pipelines.",
    imageSrc: "/neutra.png",
    link: "https://github.com/OnkarJ09",
    status: "STABLE"
  },
  {
    title: "Pass Pin Generator",
    category: "UTILITY",
    type: "automation",
    description: "Password and PIN generation utility capable of creating secure, random credentials with configurable complexity.",
    imageSrc: "/grido.png",
    link: "https://github.com/OnkarJ09",
    status: "COMPLETED"
  },
  {
    title: "Smart College Attendance",
    category: "SYSTEMS",
    type: "systems",
    description: "Command-line student attendance and record management system written in C for maintaining academic records.",
    imageSrc: "/trainly.png",
    link: "https://github.com/OnkarJ09",
    status: "COMPLETED"
  },
  {
    title: "Weather App",
    category: "API DEV",
    type: "web-dev",
    description: "Weather information application retrieving and displaying real-time weather details for specified cities.",
    imageSrc: "/landify.png",
    link: "https://github.com/OnkarJ09",
    status: "COMPLETED"
  },
  {
    title: "Greet User",
    category: "UTILITY",
    type: "automation",
    description: "Python utility generating time-based greetings according to the system clock with conditional logical triggers.",
    imageSrc: "/stickify.png",
