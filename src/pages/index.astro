---
import Layout from '../layouts/Layout.astro';
import InteractivePhoto from '../components/InteractivePhoto.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessPhases from '../components/ProcessPhases.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const featuredProjects = [
  {
    title: "VLSI Fault Detection Assistant",
    category: "AI & SYSTEMS",
    description: "An AI-powered VLSI diagnostics assistant using Astro + React, FastAPI, and RAG pipelines.",
    imageSrc: "/VLSI Fault Detection Assistant.webp",
    link: "https://github.com/OnkarJ09/vlsi_fault_detection_assistant"
  },
  {
    title: "Vedas.ai",
    category: "AI & AUTOMATION",
    description: "An intelligent virtual assistant automating tasks through voice/text with speech recognition.",
    imageSrc: "/vedas_ai.webp",
    link: "https://github.com/OnkarJ09/Vedas.ai"
  },
  {
    title: "Qwen 2.5 Chatbot",
    category: "AI DEVELOPMENT",
    description: "Local offline conversational AI chatbot powered by Qwen 2.5 running through Ollama.",
    imageSrc: "/Qwen 2.5 Chatbot.webp",
    link: "https://github.com/OnkarJ09/qwen_2_5_chatbot"
  },
  {
    title: "Auto Bug Fixer",
    category: "AI UTILITY",
    description: "AI-powered terminal tool capable of identifying, analyzing, and suggesting code fixes.",
    imageSrc: "/auto bug fixer.webp",
    link: "https://github.com/OnkarJ09/Auto-Bug-fixer"
  }
];

const principles = [
  { num: "01", name: "INTELLIGENT SYSTEMS", desc: "Building scalable AI pipelines, RAG systems, and neural networks." },
  { num: "02", name: "HARDWARE DIAGNOSTICS", desc: "Applying machine learning to VLSI engineering and diagnostics." },
  { num: "03", name: "SYSTEM AUTOMATION", desc: "Automating workflows with Python, APIs, and CLI tooling." },
  { num: "04", name: "FULL STACK FLOW", desc: "Crafting fast, clean web apps combining Astro, React, and FastAPI." }
];

const services = [
  {
    num: "01",
    name: "AI & RAG SOLUTIONS",
    desc: "Custom RAG pipelines, LLM fine-tuning, and conversational chatbot systems.",
    icon: "/creative_icon.png",
    tags: ["Retrieval-Augmented Gen", "LangChain", "Vector Databases", "Prompt Engineering"]
  },
  {
    num: "02",
    name: "WEB DEVELOPMENT",
    desc: "High-performance full stack web systems built to scale.",
    icon: "/dev_icon.png",
    tags: ["Astro & React", "FastAPI Backends", "Database Systems", "Responsive UI"]
  },
  {
    num: "03",
    name: "SYSTEM AUTOMATION",
    desc: "Automation utilities, custom APIs, script suites, and software packaging.",
    icon: "/sys_icon.png",
    tags: ["CLI Tooling", "Process Scripting", "API Development", "System Control"]
  },
  {
    num: "04",
    name: "VLSI TECHNOLOGY",
    desc: "Intelligent analytics for VLSI diagnostics and fault detection.",
    icon: "/design_icon.png",
    tags: ["Diagnostics Assistant", "Fault Analysis", "Semiconductor Data", "Data-Driven Insights"]
  }
];
---

<Layout title="Onkar Joshi - AI & VLSI Developer Portfolio">
  
  <!-- Hero Section (Removed top padding pt-3 to pt-0 and added negative margin -mt-10 to pull it further upwards directly under the header navbar) -->
  <section class="w-full max-w-[85rem] mx-auto px-6 pt-0 -mt-10 pb-24 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10 pointer-events-auto">
    <!-- Left Column -->
    <div class="lg:col-span-5 flex flex-col items-start font-['Chakra_Petch',sans-serif] justify-center reveal-on-scroll">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-zinc-950/60 border border-zinc-800 text-[9px] font-bold tracking-[0.2em] text-orange-400 mb-6 uppercase">
        <span class="w-1.5 h-1.5 bg-orange-500 rounded-full animate-ping"></span>
        AVAILABLE FOR COLLABORATION
      </div>
      
      <!-- Heading -->
      <h1 class="font-['Orbitron',sans-serif] text-3xl md:text-5xl font-black text-white leading-tight tracking-wider uppercase select-none mb-6">
        <span class="ascii-ripple-text">AI INTEGRATION</span> & <span id="hero-flip-text" class="bg-gradient-to-r from-orange-500 to-yellow-400 bg-clip-text text-transparent">VLSI TECH</span>
      </h1>
      
      <!-- Subheading -->
      <p class="text-zinc-400 text-xs md:text-sm font-normal tracking-wide leading-relaxed max-w-xl mb-8 ascii-ripple-text" data-spread="1.5">
        I am Onkar Joshi, a technology developer specializing in Python, Artificial Intelligence (LLMs/RAG), Full Stack Web Development, and VLSI Design and Technology. I design intelligent software solutions and build high-tech digital systems.
      </p>

      <!-- CTA Links -->
      <div class="flex flex-wrap items-center gap-4">
        <a 
          href="/contact" 
          class="px-5 py-3 border border-orange-500/20 hover:border-orange-500/50 bg-orange-500/5 hover:bg-orange-500/10 text-orange-400 hover:text-white rounded text-[10px] font-bold tracking-widest transition-all duration-300"
        >
          SEND REQUEST
        </a>
        <a 
          href="/works" 
          class="px-5 py-3 border border-zinc-800 hover:border-zinc-500 bg-transparent text-zinc-400 hover:text-white rounded text-[10px] font-bold tracking-widest transition-all duration-300"
        >
          EXPLORE WORKS
        </a>
      </div>
    </div>

    <!-- Right Profile Photo -->
    <div class="lg:col-span-7 w-full flex justify-center lg:justify-end items-center reveal-on-scroll reveal-delay-150">
      <div class="w-full max-w-[740px] flex justify-center lg:justify-end">
        <InteractivePhoto src="/me2.webp" alt="Onkar Joshi Portrait" />
      </div>
    </div>
  </section>

  <!-- Selected Work Grid -->
  <section class="w-full max-w-6xl mx-auto px-6 py-24 border-t border-zinc-800/10 relative z-10 pointer-events-auto reveal-on-scroll">
    <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6 mb-16 font-['Chakra_Petch',sans-serif]">
      <div>
        <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">SELECTED WORK</span>
        <h2 class="font-['Orbitron',sans-serif] text-xl md:text-2xl font-extrabold text-white tracking-widest mt-1">CURATED COLLECTION</h2>
      </div>
      <p class="text-zinc-555 text-xs tracking-wide max-w-md leading-relaxed">
        A curated collection of digital experiences shaped with strong visual direction, clean interaction, and futuristic design systems.
      </p>
    </div>

    <!-- Perspective 3D Carousel Section -->
    <div class="relative w-full overflow-visible py-8 z-20 pointer-events-auto select-none reveal-on-scroll reveal-delay-150" id="projects-carousel-container">
      <!-- Carousel Viewport -->
      <div class="relative w-full h-[530px] overflow-hidden" style="perspective: 1200px;">
        <!-- Slides Track -->
        <div 
          id="carousel-track" 
          class="relative w-full h-full"
          style="transform-style: preserve-3d;"
        >
          {featuredProjects.map((p, idx) => (
            <div 
              class="carousel-slide"
              data-index={idx}
              style="transform-style: preserve-3d; perspective: 1200px;"
            >
              <ProjectCard 
                title={p.title} 
                category={p.category} 
                description={p.description} 
                imageSrc={p.imageSrc} 
                link={p.link} 
              />
            </div>
          ))}
        </div>
      </div>

      <!-- Carousel Controls (Cyberpunk Theme) -->
      <div class="flex items-center justify-center gap-6 mt-6 font-['Chakra_Petch',sans-serif]">
        <!-- Left Button -->
        <button 
          id="carousel-prev-btn" 
          class="inline-flex size-10 items-center justify-center rounded bg-zinc-950/80 border border-zinc-800 hover:border-orange-500/40 hover:text-orange-400 text-zinc-400 transition-colors focus:outline-none cursor-pointer"
          aria-label="Previous Project"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <!-- Dots Indicators -->
        <div id="carousel-dots" class="flex items-center justify-center gap-2.5">
          {featuredProjects.map((_, idx) => (
            <button 
              class="carousel-dot h-1.5 rounded transition-all duration-300 cursor-pointer"
              data-index={idx}
              aria-label={`Go to slide ${idx + 1}`}
            />
          ))}
        </div>

        <!-- Right Button -->
        <button 
          id="carousel-next-btn" 
          class="inline-flex size-10 items-center justify-center rounded bg-zinc-950/80 border border-zinc-800 hover:border-orange-500/40 hover:text-orange-400 text-zinc-400 transition-colors focus:outline-none cursor-pointer"
          aria-label="Next Project"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Bottom link -->
    <div class="flex justify-center mt-12 reveal-on-scroll">
      <a 
        href="/works" 
        class="inline-flex items-center gap-2 text-zinc-450 hover:text-white text-xs font-bold tracking-widest transition-colors duration-300"
      >
        VIEW ALL WORKS
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- About Overview & Principles Grid -->
  <section class="w-full max-w-6xl mx-auto px-6 py-24 border-t border-zinc-800/10 relative z-10 pointer-events-auto font-['Chakra_Petch',sans-serif] reveal-on-scroll">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-16">
      <div class="lg:col-span-5">
        <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">ABOUT ME</span>
        <h2 class="font-['Orbitron',sans-serif] text-xl md:text-2xl font-extrabold text-white tracking-widest mt-1">SHARP DESIGN CLEAN FLOW</h2>
      </div>
      <div class="lg:col-span-7">
        <p class="text-zinc-455 text-xs md:text-sm leading-relaxed tracking-wide">
          I create high-impact websites and product interfaces shaped by strategy, systems, and clean execution. Every layout is structured to maintain clarity, performance, and future energy.
        </p>
      </div>
    </div>

    <!-- Principles Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {principles.map((pr, idx) => (
        <div 
          class="p-6 border border-zinc-800 bg-[#07070b] shadow-[0_8px_24px_rgba(0,0,0,0.65)] rounded group hover:border-orange-500/25 transition-all duration-300 reveal-on-scroll"
          style={`transition-delay: ${idx * 100}ms;`}
        >
          <div class="flex items-center gap-3 mb-4 select-none">
            <span class="text-[10px] font-mono text-orange-500">{pr.num}</span>
            <span class="text-[9px] font-bold tracking-widest text-zinc-400 group-hover:text-white transition-colors">{pr.name}</span>
          </div>
          <p class="text-zinc-555 text-xs leading-relaxed font-normal tracking-wide">
            {pr.desc}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Process Workflow -->
  <section class="w-full max-w-6xl mx-auto px-6 py-24 border-t border-zinc-800/10 relative z-10 pointer-events-auto reveal-on-scroll">
    <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6 mb-16 font-['Chakra_Petch',sans-serif]">
      <div>
        <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">CREATIVE WORKFLOW</span>
        <h2 class="font-['Orbitron',sans-serif] text-xl md:text-2xl font-extrabold text-white tracking-widest mt-1">PROCESS TIMELINE</h2>
      </div>
      <p class="text-zinc-555 text-xs tracking-wide max-w-md leading-relaxed">
        A focused workflow for turning early ideas into polished digital experiences through clear direction, refined design, and smooth execution.
      </p>
    </div>

    <div class="reveal-on-scroll reveal-delay-150">
      <ProcessPhases />
    </div>
  </section>

  <!-- Services Grid -->
  <section class="w-full max-w-6xl mx-auto px-6 py-24 border-t border-zinc-800/10 relative z-10 pointer-events-auto font-['Chakra_Petch',sans-serif] reveal-on-scroll">
    <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6 mb-16">
      <div>
        <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">WHAT I CREATE</span>
        <h2 class="font-['Orbitron',sans-serif] text-xl md:text-2xl font-extrabold text-white tracking-widest mt-1">CORE SERVICES</h2>
      </div>
      <p class="text-zinc-550 text-xs tracking-wide max-w-md leading-relaxed">
        High-impact services for sharp interfaces, visual systems, and polished Framer/Astro execution.
      </p>
    </div>

    <!-- Core Services Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map((s, idx) => (
        <div 
          class="p-6 md:p-8 border border-zinc-800 bg-[#07070b] shadow-[0_12px_32px_rgba(0,0,0,0.65)] rounded-lg hover:border-orange-500/25 group transition-all duration-300 reveal-on-scroll"
          style={`transition-delay: ${idx * 150}ms;`}
        >
          <div class="flex items-center justify-between gap-4 mb-4 select-none">
            <h3 class="font-['Orbitron',sans-serif] text-sm md:text-base font-extrabold text-white tracking-wider group-hover:text-orange-400 transition-colors flex items-center gap-3">
              <img src={s.icon} alt={s.name} class="w-5 h-5 object-contain invert brightness-90 group-hover:brightness-100 transition-all" />
              {s.num} {s.name}
            </h3>
          </div>
          <p class="text-zinc-500 text-xs leading-relaxed tracking-wide font-normal mb-6">
            {s.desc}
          </p>
          <div class="flex flex-wrap gap-2">
            {s.tags.map((tag) => (
              <span class="text-[9px] border border-zinc-850 px-2.5 py-1 rounded bg-[#121218] text-zinc-400 group-hover:border-zinc-800 transition-colors font-mono">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="w-full max-w-6xl mx-auto px-6 py-24 border-t border-zinc-800/10 relative z-10 pointer-events-auto reveal-on-scroll">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Label columns -->
      <div class="lg:col-span-4 font-['Chakra_Petch',sans-serif]">
        <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">SYS: CHECK</span>
        <h2 class="font-['Orbitron',sans-serif] text-xl md:text-2xl font-extrabold text-white tracking-widest mt-1">FAQs</h2>
        <p class="text-zinc-550 text-xs tracking-wide leading-relaxed mt-4">
          Everything you need to know about the creative process, timeline, project scope, and final delivery setup.
        </p>
      </div>

      <!-- FAQ Accordion -->
      <div class="lg:col-span-8 reveal-on-scroll reveal-delay-150">
        <FAQAccordion />
      </div>
    </div>
  </section>

</Layout>

<style>
  #hero-flip-text {
    perspective: 1000px;
    display: inline-block;
    transition: transform 0.5s cubic-bezier(0.2, 0.65, 0.3, 0.9), 
                opacity 0.5s cubic-bezier(0.2, 0.65, 0.3, 0.9);
    transform-origin: 50% 50% -10px;
    transform: rotateX(0deg);
    opacity: 1;
  }
  
  #hero-flip-text.flip-out {
    transform: rotateX(-90deg);
    opacity: 0;
  }
  
  #hero-flip-text.flip-in {
    transform: rotateX(90deg);
    opacity: 0;
  }

  /* 3D Carousel Styles */
  #projects-carousel-container {
    --slide-width: 500px;
    --slide-spacing: 240px;
  }
  @media (max-w: 768px) {
    #projects-carousel-container {
      --slide-width: 400px;
      --slide-spacing: 180px;
    }
  }
  @media (max-w: 480px) {
    #projects-carousel-container {
      --slide-width: 310px;
      --slide-spacing: 120px;
    }
  }
  
  .carousel-slide {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--slide-width);
    transform-style: preserve-3d;
    will-change: transform, opacity;
    transition: transform 700ms cubic-bezier(0.25, 1, 0.5, 1), 
                opacity 700ms cubic-bezier(0.25, 1, 0.5, 1);
  }
</style>

<script>
  function setupFlipText() {
    const words = ["VLSI TECH", "CYBER", "AI/ML", "WEB DEVELOPMENT"];
    let index = 0;
    const el = document.getElementById("hero-flip-text");
    if (!el) return;

    // Clear existing interval
    if ((window as any)._flipInterval) {
      clearInterval((window as any)._flipInterval);
    }

    (window as any)._flipInterval = setInterval(() => {
      // Step 1: Flip out the entire text
      el.classList.add("flip-out");
      
      setTimeout(() => {
        // Step 2: Update content
        index = (index + 1) % words.length;
        el.textContent = words[index];
        
        // Step 3: Swap classes to flip-in starting state
        el.classList.remove("flip-out");
        el.classList.add("flip-in");
        
        // Force layout reflow
        void el.offsetHeight;
        
        // Step 4: Flip in to normal state
        el.classList.remove("flip-in");
      }, 500); // matches transition time
    }, 4000);
  }

  function setupCarousel() {
    const container = document.getElementById("projects-carousel-container");
    const track = document.getElementById("carousel-track");
    const prevBtn = document.getElementById("carousel-prev-btn");
    const nextBtn = document.getElementById("carousel-next-btn");
    const dots = document.querySelectorAll(".carousel-dot");
    const slides = document.querySelectorAll(".carousel-slide");
    
    if (!container || !track || !slides.length) return;

    let currentIndex = 0;
    const maxIndex = slides.length - 1;

    function updateCarousel() {
      const spacing = parseFloat(getComputedStyle(container!).getPropertyValue("--slide-spacing"));

      slides.forEach((slide, idx) => {
        const diff = idx - currentIndex;
        const isActive = idx === currentIndex;

        const rotateY = diff * -32; // perspective rotation step
        const scale = isActive ? 1.02 : 0.8;
        const translateZ = isActive ? 0 : -220; // push inactive slides back
        const translateX = diff * spacing;

        (slide as HTMLElement).style.transform = `translate3d(calc(-50% + ${translateX}px), -50%, ${translateZ}px) rotateY(${rotateY}deg) scale(${scale})`;
        (slide as HTMLElement).style.opacity = isActive ? "1" : (Math.abs(diff) === 1 ? "0.38" : "0.08");
        (slide as HTMLElement).style.pointerEvents = isActive ? "auto" : "none";
        (slide as HTMLElement).style.zIndex = isActive ? "10" : `${5 - Math.abs(diff)}`;
      });

      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add("w-8", "bg-orange-500", "opacity-100");
          dot.classList.remove("w-2.5", "bg-zinc-700", "opacity-30");
        } else {
          dot.classList.remove("w-8", "bg-orange-500", "opacity-100");
          dot.classList.add("w-2.5", "bg-zinc-700", "opacity-30");
        }
      });
    }

    // ---- Scroll is the single source of truth for the active slide ----
    // The carousel advances as the section's center travels from 85% -> 15%
    // of the viewport. Every manual control (arrows, dots, swipe, wheel) is
    // funneled through scrollToSlide(), which scrolls the page to the band
    // that maps to the chosen slide. This keeps the scroll position and the
    // visible slide in lockstep: no snap-back, no override conflicts.

    function computeTargetIndex() {
      const rect = container!.getBoundingClientRect();
      const vh = window.innerHeight;
      const center = rect.top + rect.height / 2;
      const startY = vh * 0.85;
      const endY = vh * 0.15;
      const distanceRange = startY - endY;
      const offset = startY - center;
      const ratio = Math.max(0, Math.min(0.99, offset / distanceRange));
      return Math.floor(ratio * slides.length);
    }

    function syncToScroll() {
      const targetIndex = computeTargetIndex();
      if (targetIndex !== currentIndex && targetIndex >= 0 && targetIndex <= maxIndex) {
        currentIndex = targetIndex;
        updateCarousel();
      }
    }

    // rAF-throttled scroll handler for smooth, jank-free syncing
    let ticking = false;
    let isProgrammaticScroll = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        if (!isProgrammaticScroll) {
          syncToScroll();
        } else if (computeTargetIndex() === currentIndex) {
          // Programmatic smooth-scroll has landed on its target band:
          // release the guard so manual scrolling resumes cleanly.
          isProgrammaticScroll = false;
        }
      });
    }

    // Center slide `k` by scrolling the page to the band that maps to it.
    // Using the band center (k + 0.5) / N keeps computeTargetIndex()'s floor() steady.
    function scrollToSlide(k: number) {
      const clamped = Math.max(0, Math.min(maxIndex, k));
      const ratio = (clamped + 0.5) / slides.length;
      const vh = window.innerHeight;
      const targetCenter = vh * 0.85 - ratio * (vh * 0.7);
      const rect = container!.getBoundingClientRect();
      const currentCenter = rect.top + rect.height / 2;
      const delta = currentCenter - targetCenter;
      window.scrollTo({ top: window.scrollY + delta, behavior: "smooth" });
    }

    function gotoIndex(k: number) {
      const clamped = Math.max(0, Math.min(maxIndex, k));
      if (clamped === currentIndex) return;
      // Swap the slide instantly, then silently scroll the page to the
      // matching band under a guard (no intermediate-slide flicker).
      currentIndex = clamped;
      updateCarousel();
      isProgrammaticScroll = true;
      scrollToSlide(clamped);
    }

    function slidePrev() {
      gotoIndex(currentIndex > 0 ? currentIndex - 1 : maxIndex);
    }

    function slideNext() {
      gotoIndex(currentIndex < maxIndex ? currentIndex + 1 : 0);
    }

    // Remove existing event listeners by cloning button elements if needed
    prevBtn?.replaceWith(prevBtn.cloneNode(true));
    nextBtn?.replaceWith(nextBtn.cloneNode(true));

    const newPrevBtn = document.getElementById("carousel-prev-btn");
    const newNextBtn = document.getElementById("carousel-next-btn");

    newPrevBtn?.addEventListener("click", slidePrev);
    newNextBtn?.addEventListener("click", slideNext);

    dots.forEach((dot, idx) => {
      const clone = dot.cloneNode(true);
      dot.replaceWith(clone);
      clone.addEventListener("click", () => gotoIndex(idx));
    });

    // Touch Swipe Navigation
    let touchStartX = 0;
    let touchEndX = 0;

    container.addEventListener("touchstart", (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    container.addEventListener("touchend", (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const swipeDistance = touchEndX - touchStartX;
      if (swipeDistance > 55) {
        slidePrev();
      } else if (swipeDistance < -55) {
        slideNext();
      }
    }, { passive: true });

    // Wheel Scroll Navigation (Horizontal Swiping Only)
    let lastWheelTime = 0;
    container.addEventListener("wheel", (e: WheelEvent) => {
      // Only trigger slide transitions for horizontal swipes (deltaX), keeping vertical page scroll intact
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY) && Math.abs(e.deltaX) > 10) {
        e.preventDefault();
        const now = Date.now();
        if (now - lastWheelTime < 600) return;

        if (e.deltaX > 0) {
          slideNext();
        } else {
          slidePrev();
        }
        lastWheelTime = now;
      }
    }, { passive: false });

    // Clean up any existing scroll sync listeners (survive astro page swaps)
    if ((window as any)._carouselScrollListener) {
      window.removeEventListener("scroll", (window as any)._carouselScrollListener);
    }
    if ((window as any)._carouselScrollEndListener) {
      window.removeEventListener("scrollend", (window as any)._carouselScrollEndListener);
    }

    // Safety net: a programmatic smooth-scroll might not fire the final
    // scroll event reliably (or at exact band center). scrollend fires once
    // when the glide settles, so force-clear the guard and re-sync there.
    const onScrollEnd = () => {
      if (!isProgrammaticScroll) return;
      isProgrammaticScroll = false;
      syncToScroll();
    };
    window.addEventListener("scrollend", onScrollEnd, { passive: true });
    (window as any)._carouselScrollEndListener = onScrollEnd;
    (window as any)._carouselScrollListener = onScroll;
    window.addEventListener("scroll", onScroll, { passive: true });

    // Handle Window Resize
    window.addEventListener("resize", updateCarousel);

    // Initial load state: place the carousel, then immediately sync the
    // active slide to the current scroll position (fixes landing mid-section).
    updateCarousel();
    syncToScroll();
  }

  function initPage() {
    setupFlipText();
    setupCarousel();
  }

  // Run on page load and astro page swap transitions
  initPage();
  document.addEventListener("astro:after-swap", initPage);
</script>
