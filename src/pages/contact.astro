---
import Layout from '../layouts/Layout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
---

<Layout title="Contact Onkar Joshi - Get in Touch">
  <main class="w-full max-w-6xl mx-auto px-6 py-16 md:py-24 relative z-10 pointer-events-auto font-['Chakra_Petch',sans-serif]">
    <!-- Header banner -->
    <div class="cyber-divider-b pb-12 mb-16">
      <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">SYS: CONTACT</span>
      <h1 class="font-['Orbitron',sans-serif] text-2xl md:text-4xl font-extrabold text-white tracking-widest mt-2 uppercase ascii-ripple-text">
        CONTACT CHANNEL
      </h1>
      <p class="text-zinc-550 text-xs md:text-sm tracking-wide mt-4 max-w-xl leading-relaxed">
        Send a few details about your project, and I’ll get back with a clear direction, scope, timeline, and practical next steps for building something sharp, focused, and ready to launch.
      </p>
    </div>

    <!-- Contact Grid System -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-24">
      
      <!-- Left sidebar meta parameters -->
      <div class="lg:col-span-4 flex flex-col gap-6 font-['Chakra_Petch',sans-serif]">
        <!-- Status Box -->
        <div class="p-6 border border-zinc-800 bg-[#07070b] shadow-[0_4px_16px_rgba(0,0,0,0.5)] rounded-lg">
          <span class="text-[8px] font-bold tracking-widest text-zinc-500 block mb-2 uppercase">SIGNAL STATUS</span>
          <div class="flex items-center justify-between">
            <span class="text-xs text-white font-semibold">AVAILABLE FOR HIRE</span>
            <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse"></span>
          </div>
        </div>

        <div class="p-6 border border-zinc-800 bg-[#07070b] shadow-[0_4px_16px_rgba(0,0,0,0.5)] rounded-lg flex flex-col gap-4 font-['Chakra_Petch',sans-serif]">
          <div>
            <span class="text-[8px] font-bold tracking-widest text-zinc-550 block mb-1 uppercase">RESPONSE SPEED</span>
            <span class="text-xs text-white font-semibold">WITHIN 24 HOURS</span>
          </div>
          <div>
            <span class="text-[8px] font-bold tracking-widest text-zinc-550 block mb-1 uppercase">SIGNAL SECURITY</span>
            <span class="text-xs text-white font-semibold">STRONG ENCRYPTION</span>
          </div>
        </div>

        <div class="p-6 border border-zinc-800 bg-[#07070b] shadow-[0_4px_16px_rgba(0,0,0,0.5)] rounded-lg flex flex-col gap-4 font-['Chakra_Petch',sans-serif]">
          <div>
            <span class="text-[8px] font-bold tracking-widest text-zinc-550 block mb-1 uppercase">EMAIL CHANNEL</span>
            <a href="mailto:onkar.joshi2105@gmail.com" class="text-xs text-orange-400 font-semibold hover:text-white transition-colors">ONKAR.JOSHI2105@GMAIL.COM</a>
          </div>
          <div>
            <span class="text-[8px] font-bold tracking-widest text-zinc-550 block mb-1 uppercase">GEOGRAPHY</span>
            <span class="text-xs text-white font-semibold">NAGPUR, INDIA</span>
          </div>
        </div>
      </div>

      <!-- Contact Form (Right) -->
      <div class="lg:col-span-8 p-6 md:p-8 border border-zinc-800/40 bg-zinc-950/10 rounded-lg relative">
        <div class="absolute top-0 left-0 w-2.5 h-2.5 border-t border-l border-zinc-700 pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-2.5 h-2.5 border-t border-r border-zinc-700 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-2.5 h-2.5 border-b border-l border-zinc-700 pointer-events-none"></div>
        <div class="absolute bottom-0 right-0 w-2.5 h-2.5 border-b border-r border-zinc-700 pointer-events-none"></div>
        <form id="contact-form" class="flex flex-col gap-6">
          <!-- Name and email row -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
              <label class="text-[9px] font-bold tracking-widest text-zinc-500 uppercase">YOUR NAME</label>
              <input 
                type="text" 
                name="name"
                required 
                placeholder="Jane Smith" 
                class="w-full bg-[#121218] border border-zinc-800 focus:border-orange-500/50 text-xs text-white rounded px-4 py-3 font-mono tracking-wider focus:outline-none transition-colors"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label class="text-[9px] font-bold tracking-widest text-zinc-500 uppercase">EMAIL ADDRESS</label>
              <input 
                type="email" 
                name="email"
                required 
                placeholder="Enter your email" 
                class="w-full bg-[#121218] border border-zinc-800 focus:border-orange-500/50 text-xs text-white rounded px-4 py-3 font-mono tracking-wider focus:outline-none transition-colors"
              />
            </div>
          </div>

          <!-- Project Parameters row -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
              <label class="text-[9px] font-bold tracking-widest text-zinc-500 uppercase">PROJECT TYPE</label>
              <select 
                name="projectType"
                class="w-full bg-[#121218] border border-zinc-800 focus:border-orange-500/50 text-xs text-white rounded px-4 py-3 tracking-wide focus:outline-none transition-colors cursor-pointer appearance-none"
                style="background-image: url('data:image/svg+xml;utf8,<svg fill=%22%2371717a%22 height=%2224%22 viewBox=%220 0 24 24%22 width=%2224%22 xmlns=%22http://www.w3.org/2000/svg%22><path d=%22M7 10l5 5 5-5z%22/></svg>'); background-repeat: no-repeat; background-position: right 12px center;"
              >
                <option value="">Select...</option>
                <option value="WEB DESIGN & DEVELOPMENT">WEB DESIGN & DEVELOPMENT</option>
                <option>BRAND DESIGN SYSTEM</option>
                <option>UX/UI PRODUCT SYSTEM</option>
              </select>
            </div>
            
            <div class="flex flex-col gap-2">
              <label class="text-[9px] font-bold tracking-widest text-zinc-550 uppercase">TIMELINE</label>
              <select 
                name="timeline"
                class="w-full bg-[#121218] border border-zinc-800 focus:border-orange-500/50 text-xs text-white rounded px-4 py-3 tracking-wide focus:outline-none transition-colors cursor-pointer appearance-none"
                style="background-image: url('data:image/svg+xml;utf8,<svg fill=%22%2371717a%22 height=%2224%22 viewBox=%220 0 24 24%22 width=%2224%22 xmlns=%22http://www.w3.org/2000/svg%22><path d=%22M7 10l5 5 5-5z%22/></svg>'); background-repeat: no-repeat; background-position: right 12px center;"
              >
                <option value="">Select...</option>
                <option value="< 2 weeks">&lt; 2 weeks</option>
                <option value="2 - 4 weeks">2 - 4 weeks</option>
                <option value="1 - 2 months">1 - 2 months</option>
                <option value="Flexible">Flexible</option>
              </select>
            </div>
          </div>

          <!-- Project Details -->
          <div class="flex flex-col gap-2">
            <label class="text-[9px] font-bold tracking-widest text-zinc-500 uppercase">PROJECT DETAILS</label>
            <textarea 
              name="details"
              required 
              rows="5" 
              placeholder="Tell me about your project, goals, and any details." 
              class="w-full bg-[#121218] border border-zinc-800 focus:border-orange-500/50 text-xs text-white rounded px-4 py-3 focus:outline-none transition-colors leading-relaxed"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            class="w-full mt-4 py-3.5 border border-orange-500/20 hover:border-orange-500/60 bg-orange-500/5 hover:bg-orange-500/10 text-orange-400 hover:text-white rounded text-[10px] font-bold tracking-widest transition-all duration-300"
          >
            SEND REQUEST
          </button>
        </form>

        <!-- Success State Overlay -->
        <div id="contact-success" class="hidden flex-col items-center justify-center py-12 text-center font-mono text-xs select-none">
          <div class="inline-flex items-center justify-center size-14 rounded-full border border-emerald-500/30 bg-emerald-500/5 text-emerald-400 mb-6 animate-pulse">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          
          <div class="text-[10px] font-bold tracking-[0.25em] text-emerald-400 uppercase mb-2">
            [ UPLINK SECURED ]
          </div>
          <h3 class="font-['Orbitron',sans-serif] text-base font-bold text-white tracking-widest uppercase mb-4">
            TRANSMISSION RECEIVED
          </h3>
          
          <div class="w-full max-w-sm p-4 rounded border border-zinc-850 bg-[#0d0d12]/60 text-left text-[10px] text-zinc-450 leading-relaxed mb-6 flex flex-col gap-1.5 border-t-2 border-t-emerald-500/50">
            <div><span class="text-emerald-500 font-bold">SYS_LOG:</span> INITIALIZING SECURE PACKET ROUTER...</div>
            <div><span class="text-emerald-500 font-bold">SYS_LOG:</span> TARGET INBOX: ONKAR.JOSHI2105@GMAIL.COM</div>
            <div><span class="text-emerald-500 font-bold">SYS_LOG:</span> PACKET STATUS: DELIVERED (200 OK)</div>
            <div><span class="text-zinc-650">-------------------------------------------</span></div>
            <div class="text-zinc-400">Signal successfully routed. Onkar will analyze your details and get back to you within 24 hours.</div>
          </div>

          <button 
            type="button"
            id="reset-form-btn"
            class="px-6 py-2.5 border border-zinc-800 hover:border-orange-500/40 hover:text-orange-400 text-zinc-400 bg-zinc-950/40 hover:bg-orange-500/5 rounded text-[9px] font-bold tracking-widest transition-all duration-300 cursor-pointer"
          >
            SEND NEW SIGNAL
          </button>
        </div>

        <!-- Failure State Overlay -->
        <div id="contact-failure" class="hidden flex-col items-center justify-center py-12 text-center font-mono text-xs select-none">
          <div class="inline-flex items-center justify-center size-14 rounded-full border border-red-500/30 bg-red-500/5 text-red-400 mb-6 animate-pulse">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          
          <div class="text-[10px] font-bold tracking-[0.25em] text-red-400 uppercase mb-2">
            [ UPLINK FAILED ]
          </div>
          <h3 class="font-['Orbitron',sans-serif] text-base font-bold text-white tracking-widest uppercase mb-4">
            TRANSMISSION REJECTED
          </h3>
          
          <div class="w-full max-w-sm p-4 rounded border border-zinc-850 bg-[#0d0d12]/60 text-left text-[10px] text-zinc-450 leading-relaxed mb-6 flex flex-col gap-1.5 border-t-2 border-t-red-500/50">
            <div><span class="text-red-500 font-bold">SYS_ERR:</span> CONNECTIVITY TIMEOUT OR FIELD VERIFICATION FAILURE.</div>
            <div><span class="text-zinc-650">-------------------------------------------</span></div>
            <div class="text-zinc-400">The gateway could not route the message. Please check that your email is valid and try sending again.</div>
          </div>

          <button 
            type="button"
            id="retry-form-btn"
            class="px-6 py-2.5 border border-zinc-800 hover:border-orange-500/40 hover:text-orange-400 text-zinc-400 bg-zinc-950/40 hover:bg-orange-500/5 rounded text-[9px] font-bold tracking-widest transition-all duration-300 cursor-pointer"
          >
            RETRY TRANSMISSION
          </button>
        </div>
      </div>

    </div>

    <!-- FAQ Accordion section -->
    <div class="border-t border-zinc-800/20 pt-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-4">
          <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">CLEAR ANSWERS</span>
          <h2 class="font-['Orbitron',sans-serif] text-xl md:text-2xl font-extrabold text-white tracking-widest mt-1">PRE-BUILD FAQ</h2>
          <p class="text-zinc-550 text-xs tracking-wide leading-relaxed mt-4 max-w-sm">
            Everything you need to know about the process, timeline, Framer/Astro setup, and final project delivery.
          </p>
        </div>
        <div class="lg:col-span-8">
          <FAQAccordion />
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successEl = document.getElementById('contact-success');
    const failureEl = document.getElementById('contact-failure');
    if (!form || !successEl || !failureEl) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn ? submitBtn.textContent : 'SEND REQUEST';

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'TRANSMITTING...';
      }

      const formData = new FormData(form);

      try {
        const response = await fetch('https://formspree.io/f/mlgqapzb', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          form.classList.add('hidden');
          successEl.classList.remove('hidden');
          successEl.classList.add('flex');
          form.reset();
        } else {
          form.classList.add('hidden');
          failureEl.classList.remove('hidden');
          failureEl.classList.add('flex');
        }
      } catch (error) {
        form.classList.add('hidden');
        failureEl.classList.remove('hidden');
        failureEl.classList.add('flex');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      }
    });

    const resetBtn = document.getElementById('reset-form-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        successEl.classList.add('hidden');
        successEl.classList.remove('flex');
        form.classList.remove('hidden');
      });
    }

    const retryBtn = document.getElementById('retry-form-btn');
    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        failureEl.classList.add('hidden');
        failureEl.classList.remove('flex');
        form.classList.remove('hidden');
      });
    }
  }

  // Run on page load and astro page transitions
  setupContactForm();
  document.addEventListener("astro:after-swap", setupContactForm);
</script>
