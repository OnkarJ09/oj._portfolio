---
import Layout from '../../layouts/Layout.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, index) => {
    const prevProject = index > 0 ? projects[index - 1] : projects[projects.length - 1];
    const nextProject = index < projects.length - 1 ? projects[index + 1] : projects[0];
    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject }
    };
  });
}

interface Props {
  project: Project;
  prevProject: Project;
  nextProject: Project;
}

const { project, prevProject, nextProject } = Astro.props;
---

<Layout title={`${project.title} — Project Case Study | Onkar Joshi`}>
  <main class="w-full max-w-5xl mx-auto px-6 py-14 md:py-20 relative z-10 pointer-events-auto font-['Chakra_Petch',sans-serif]">
    
    <!-- Top Breadcrumb & HUD Telemetry -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-8 mb-8 border-b border-zinc-800/40 text-[11px] font-mono tracking-widest text-zinc-500">
      <div class="flex items-center gap-2">
        <a href="/works" class="hover:text-orange-400 transition-colors flex items-center gap-1.5 text-zinc-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          ARCHIVE
        </a>
        <span class="text-zinc-650">/</span>
        <span class="text-orange-400 font-bold uppercase">{project.slug}</span>
      </div>

      <div class="flex items-center gap-4 text-[10px]">
        <div class="flex items-center gap-1.5">
          <span class={`w-1.5 h-1.5 rounded-full ${project.status === 'ACTIVE' ? 'bg-emerald-500 animate-ping' : 'bg-orange-500'}`}></span>
          <span class="text-zinc-350 font-bold">STATUS: {project.status}</span>
        </div>
        <div class="hidden sm:block text-zinc-500">
          TIMELINE: <span class="text-zinc-300 font-bold">{project.timeline}</span>
        </div>
      </div>
    </div>

    <!-- Hero Title & Actions Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-12">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-zinc-950/80 border border-zinc-800 text-[9px] font-bold tracking-[0.2em] text-orange-400 mb-4 uppercase">
          {project.category}
        </div>
        <h1 class="font-['Orbitron',sans-serif] text-2xl sm:text-4xl lg:text-5xl font-black text-white tracking-wider uppercase leading-tight ascii-ripple-text">
          {project.title}
        </h1>
        <p class="text-zinc-400 text-xs sm:text-sm tracking-wide mt-4 leading-relaxed font-normal">
          {project.description}
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3">
        <a 
          href={project.link} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-6 py-3.5 border border-orange-500/30 hover:border-orange-500/70 bg-orange-500/10 hover:bg-orange-500/20 text-orange-400 hover:text-white rounded-sm text-xs font-bold tracking-[0.2em] transition-all duration-300 shadow-[0_0_20px_rgba(249,115,22,0.15)] group"
        >
          VIEW SOURCE ON GITHUB
          <svg class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
        <a 
          href="/works" 
          class="inline-flex items-center gap-2 px-5 py-3.5 border border-zinc-800 hover:border-zinc-600 bg-zinc-950/60 text-zinc-400 hover:text-white rounded-sm text-xs font-bold tracking-widest transition-all duration-300"
        >
          ALL WORKS
        </a>
      </div>
    </div>

    <!-- Featured Screenshot Frame -->
    <div class="relative w-full aspect-[16/9] md:aspect-[21/9] rounded-lg overflow-hidden border border-zinc-800 bg-[#07070b] shadow-[0_16px_48px_rgba(0,0,0,0.8)] mb-16 group">
      <!-- Cyber Corner Brackets -->
      <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-orange-500/70 z-20 pointer-events-none"></div>
      <div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-orange-500/70 z-20 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-orange-500/70 z-20 pointer-events-none"></div>
      <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-orange-500/70 z-20 pointer-events-none"></div>

      <!-- Scanlines overlay -->
      <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.35)_50%)] bg-[length:100%_4px] opacity-25 z-10"></div>
      
      <img 
        src={project.imageSrc} 
        alt={project.title}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
      />

      <div class="absolute bottom-4 left-4 z-20 px-3 py-1 rounded bg-[#07070b]/90 border border-zinc-800 text-[10px] font-mono text-zinc-400">
        SYS_SCREENSHOT: {project.slug}.webp
      </div>
    </div>

    <!-- Two-Column Deep Dive Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-20">
      
      <!-- Left Column: Detailed Overview & Highlights -->
      <div class="lg:col-span-8 flex flex-col gap-10">
        <!-- Overview -->
        <div>
          <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase block mb-2">SYSTEM SPECS</span>
          <h2 class="font-['Orbitron',sans-serif] text-xl font-bold tracking-widest text-white uppercase mb-4">
            ENGINEERING OVERVIEW
          </h2>
          <p class="text-zinc-350 text-sm sm:text-base leading-relaxed tracking-wide font-normal">
            {project.longDescription}
          </p>
        </div>

        <!-- Key Technical Highlights -->
        <div>
          <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase block mb-2">SYSTEM BREAKTHROUGHS</span>
          <h2 class="font-['Orbitron',sans-serif] text-xl font-bold tracking-widest text-white uppercase mb-6">
            CORE CAPABILITIES & HIGHLIGHTS
          </h2>
          
          <div class="grid grid-cols-1 gap-4">
            {project.highlights.map((highlight, idx) => (
              <div class="p-4 rounded border border-zinc-800/80 bg-[#07070b] hover:border-orange-500/30 transition-all duration-300 flex items-start gap-4">
                <span class="font-mono text-xs font-bold text-orange-400 mt-0.5">
                  0{idx + 1}
                </span>
                <p class="text-zinc-350 text-xs sm:text-sm leading-relaxed tracking-wide font-normal">
                  {highlight}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- Simulated Terminal Preview -->
        {project.terminalPreview && (
          <div>
            <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase block mb-2">TELEMETRY PREVIEW</span>
            <h2 class="font-['Orbitron',sans-serif] text-xl font-bold tracking-widest text-white uppercase mb-4">
              EXECUTION TERMINAL
            </h2>

            <div class="rounded-lg border border-zinc-800 bg-[#0a0a0f] overflow-hidden shadow-2xl font-mono text-xs">
              <!-- Terminal Bar -->
              <div class="h-9 bg-zinc-900/80 px-4 border-b border-zinc-800/60 flex items-center justify-between select-none">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
                </div>
                <span class="text-[10px] text-zinc-500 tracking-wider">PROJECT_CLI_TELEMETRY.SH</span>
                <div class="w-12"></div>
              </div>

              <!-- Terminal Content -->
              <div class="p-5 flex flex-col gap-2 overflow-x-auto text-zinc-400 leading-relaxed">
                <div class="flex items-center gap-2 text-emerald-400 font-bold">
                  <span class="text-orange-500">❯</span>
                  <span>{project.terminalPreview.command}</span>
                </div>
                <div class="h-px bg-zinc-850 my-1"></div>
                {project.terminalPreview.output.map((line) => (
                  <div class="text-zinc-400 text-[11px] font-mono whitespace-pre-wrap">
                    {line}
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Sidebar Meta Parameters -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        
        <!-- Tech Stack Block -->
        <div class="p-6 border border-zinc-800 bg-[#07070b] rounded-lg shadow-xl">
          <span class="text-[9px] font-bold tracking-widest text-zinc-500 block mb-3 uppercase">TECHNOLOGY STACK</span>
          <div class="flex flex-wrap gap-2">
            {project.techStack.map((tech) => (
              <span class="text-xs border border-zinc-800 px-3 py-1.5 rounded bg-[#121218] text-orange-300 font-mono font-medium tracking-wide">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Project Meta Parameters -->
        <div class="p-6 border border-zinc-800 bg-[#07070b] rounded-lg flex flex-col gap-4 text-xs">
          <div>
            <span class="text-[9px] font-bold tracking-widest text-zinc-500 block mb-1 uppercase">REPOSITORY HOST</span>
            <span class="text-white font-mono font-semibold">GITHUB // ONKARJ09</span>
          </div>
          <div>
            <span class="text-[9px] font-bold tracking-widest text-zinc-500 block mb-1 uppercase">LICENSE</span>
            <span class="text-white font-mono font-semibold">APACHE LICENSE 2.0</span>
          </div>
          <div>
            <span class="text-[9px] font-bold tracking-widest text-zinc-500 block mb-1 uppercase">ARCHITECTURE CLASSIFICATION</span>
            <span class="text-orange-400 font-bold uppercase">{project.type}</span>
          </div>
        </div>

        <!-- Contact Callout -->
        <div class="p-6 border border-orange-500/20 bg-orange-500/5 rounded-lg flex flex-col gap-3">
          <span class="text-[9px] font-bold tracking-widest text-orange-400 uppercase">INTERESTED IN THIS TECH?</span>
          <p class="text-zinc-400 text-xs leading-relaxed font-normal">
            Have questions about the architecture or interested in collaborating on similar systems?
          </p>
          <a 
            href="/contact" 
            class="mt-2 text-xs text-orange-400 hover:text-white font-bold tracking-wider inline-flex items-center gap-1.5 transition-colors"
          >
            SEND A DIRECT SIGNAL →
          </a>
        </div>
      </div>
    </div>

    <!-- Continuous Browsing: Next & Previous Project Switcher -->
    <div class="border-t border-zinc-800/40 pt-12">
      <div class="flex items-center justify-between mb-6">
        <span class="text-[9px] font-bold tracking-widest text-zinc-500 uppercase">EXPLORE MORE ARCHIVES</span>
        <a href="/works" class="text-xs text-zinc-400 hover:text-white transition-colors">VIEW ALL (12) →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Previous Project -->
        <a 
          href={`/works/${prevProject.slug}`}
          class="p-5 border border-zinc-800 hover:border-orange-500/30 bg-[#07070b] rounded-lg transition-all duration-300 group flex flex-col gap-2"
        >
          <span class="text-[9px] font-mono text-zinc-500 uppercase tracking-widest flex items-center gap-1 group-hover:text-orange-400 transition-colors">
            ← PREVIOUS PROJECT
          </span>
          <h3 class="font-['Orbitron',sans-serif] text-sm md:text-base font-bold text-white group-hover:text-orange-400 transition-colors">
            {prevProject.title}
          </h3>
          <span class="text-[10px] text-zinc-500 uppercase">{prevProject.category}</span>
        </a>

        <!-- Next Project -->
        <a 
          href={`/works/${nextProject.slug}`}
          class="p-5 border border-zinc-800 hover:border-orange-500/30 bg-[#07070b] rounded-lg transition-all duration-300 group flex flex-col gap-2 md:items-end text-left md:text-right"
        >
          <span class="text-[9px] font-mono text-zinc-500 uppercase tracking-widest flex items-center gap-1 group-hover:text-orange-400 transition-colors">
            NEXT PROJECT →
          </span>
          <h3 class="font-['Orbitron',sans-serif] text-sm md:text-base font-bold text-white group-hover:text-orange-400 transition-colors">
            {nextProject.title}
          </h3>
          <span class="text-[10px] text-zinc-500 uppercase">{nextProject.category}</span>
        </a>
      </div>
    </div>

  </main>
</Layout>
