---
import Layout from '../layouts/Layout.astro';

const timeline = [
  { year: "2026", title: "VLSI DIAGNOSTICS & RAG DEVELOPMENT", desc: "Designed and developed an AI-powered VLSI diagnostics assistant combining Astro + React frontend and FastAPI backend with a RAG pipeline utilizing FAISS and LangChain." },
  { year: "2025", title: "FULL STACK WEB DEVELOPMENT INTERNSHIP", desc: "Internship at Internshala covering HTML, CSS, JavaScript, PHP, Bootstrap, and MySQL. Developed a responsive student PG accommodation platform." },
  { year: "2024", title: "AI, ML, DL & PYTHON INTERNSHIP", desc: "Completed training and projects in Python, Machine Learning, and Deep Learning at Pantech Solutions with model training and computer vision implementation." },
  { year: "2023", title: "ACADEMIC & LEADERSHIP MILESTONES", desc: "Pursued B.Tech in VLSI Design & Technology. Served as Design Head in IETE Student Chapter and Design Co-Head in YASH26.0 and EESA." },
  { year: "2022", title: "HIGHER SECONDARY EDUCATION", desc: "Completed HSC certification at MKH Sancheti Public School & Junior College with focus on science and technical foundations." },
  { year: "2020", title: "SECONDARY SCHOOL EDUCATION", desc: "Completed SSC certification at Modern High School, WCL, Umred." }
];

const tools = [
  { name: "PYTHON", category: "LANGUAGE", level: "EXPERT" },
  { name: "C / C++", category: "LANGUAGE", level: "ADVANCED" },
  { name: "SQL & POSTGRESQL", category: "DATABASE", level: "ADVANCED" },
  { name: "FASTAPI & API DEV", category: "FRAMEWORK", level: "EXPERT" },
  { name: "ASTRO & REACT", category: "WEB DEV", level: "ADVANCED" },
  { name: "LANGCHAIN & FAISS", category: "AI / RAG", level: "EXPERT" },
  { name: "DOCKER & LINUX", category: "SYSTEM", level: "PRACTICAL" },
  { name: "GIT & GITHUB", category: "WORKFLOW", level: "EXPERT" },
  { name: "FIGMA & FIGMA DEV", category: "DESIGN", level: "PRACTICAL" }
];
---

<Layout title="About Onkar Joshi - Profile Details">
  <main class="w-full max-w-6xl mx-auto px-6 py-16 md:py-24 relative z-10 pointer-events-auto font-['Chakra_Petch',sans-serif]">
    <!-- Header banner -->
    <div class="cyber-divider-b pb-12 mb-16">
      <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">SYS: PROFILE</span>
      <h1 class="font-['Orbitron',sans-serif] text-2xl md:text-4xl font-extrabold text-white tracking-widest mt-2 uppercase ascii-ripple-text">
        ABOUT PROFILE
      </h1>
      <p class="text-zinc-550 text-xs md:text-sm tracking-wide mt-4 max-w-xl leading-relaxed">
        I build intelligent software solutions and design high-tech hardware/software integrations. From custom RAG implementations to robust full stack engineering, my focus is on efficiency and quality.
      </p>
    </div>

    <!-- Biography section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-24">
      <div class="lg:col-span-8 flex flex-col gap-6">
        <span class="text-[9px] font-bold tracking-[0.2em] text-zinc-500 block uppercase">ABOUT ME</span>
        <h2 class="font-['Orbitron',sans-serif] text-xl font-bold tracking-widest text-white uppercase leading-snug">
          BEHIND THE TECH.<br/>THIS IS WHO I AM
        </h2>
        <p class="text-zinc-450 text-xs md:text-sm leading-relaxed tracking-wide font-normal">
          I'm Onkar Joshi, an AI developer and VLSI Design & Technology B.Tech student based in Nagpur, India. I specialize in building intelligent applications using Python, Large Language Models (LLMs), RAG pipelines, and modern web frameworks like Astro, React, and FastAPI.
        </p>
        <p class="text-zinc-450 text-xs md:text-sm leading-relaxed tracking-wide font-normal">
          My work is centered around merging software engineering with hardware diagnostics, creating tools that automate complex analysis workflows. I have a strong foundation in databases, networking, cybersecurity, and DevOps basics.
        </p>
        <p class="text-zinc-450 text-xs md:text-sm leading-relaxed tracking-wide font-normal">
          In addition to my technical work, I have held leadership and design roles, serving as Design Head for student forums and organizing branding campaigns for academic events.
        </p>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="lg:col-span-4 grid grid-cols-1 gap-4">
        <div class="p-6 border border-sky-700/40 bg-[#07070b] shadow-[0_4px_16px_rgba(14,165,233,0.12)] rounded-lg">
          <span class="text-[9px] font-bold tracking-widest text-sky-400 block mb-2 font-mono">EDUCATION</span>
          <div class="flex items-baseline gap-2">
            <span class="font-['Orbitron',sans-serif] text-xl font-black text-white">B.Tech</span>
            <span class="text-[9px] text-sky-300 font-bold uppercase">VLSI DESIGN & TECH</span>
          </div>
        </div>
        <div class="p-6 border border-emerald-700/40 bg-[#07070b] shadow-[0_4px_16px_rgba(16,185,129,0.12)] rounded-lg">
          <span class="text-[9px] font-bold tracking-widest text-emerald-400 block mb-2 font-mono">PROJECTS BUILT</span>
          <div class="flex items-baseline gap-2">
            <span class="font-['Orbitron',sans-serif] text-3xl font-black text-orange-400">10+</span>
            <span class="text-[10px] text-emerald-300 font-bold uppercase">ACTIVE SYSTEMS</span>
          </div>
        </div>
        <div class="p-6 border border-violet-700/40 bg-[#07070b] shadow-[0_4px_16px_rgba(139,92,246,0.12)] rounded-lg">
          <span class="text-[9px] font-bold tracking-widest text-violet-400 block mb-2 font-mono">CREDENTIALS</span>
          <div class="flex items-baseline gap-2">
            <span class="font-['Orbitron',sans-serif] text-3xl font-black text-orange-400">2+</span>
            <span class="text-[10px] text-violet-300 font-bold uppercase">INTERNSHIPS</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Process Terminal Section -->
    <div class="border-t border-zinc-800/20 pt-16 mb-24">
      <div class="flex flex-col gap-2 mb-12">
        <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">SYS: WORKFLOW</span>
        <h2 class="font-['Orbitron',sans-serif] text-base md:text-lg font-bold tracking-wider text-white">PROCESS TERMINAL</h2>
      </div>

      <!-- Cyber Terminal UI -->
      <div class="w-full max-w-3xl mx-auto border border-zinc-800/60 bg-[#0a0a0f] rounded-lg overflow-hidden relative shadow-2xl">
        <!-- Terminal Header -->
        <div class="w-full h-9 bg-zinc-900/80 px-4 border-b border-zinc-800/50 flex items-center justify-between select-none">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
          </div>
          <span class="text-[9px] font-mono text-zinc-500 tracking-wider">ONKAR_PROCESS_SYSTEM.SH</span>
          <div class="w-10"></div>
        </div>
        
        <!-- Terminal Body -->
        <div class="p-6 font-mono text-[11px] leading-relaxed text-zinc-400 min-h-[320px] flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1.5 mb-2 text-zinc-500">
              <span>onkar@terminal:~$</span>
              <span class="text-orange-400">cat workflow.log</span>
            </div>
            
            <!-- Terminal entries -->
            <div class="flex flex-col gap-2 mb-6">
              <div><span class="text-zinc-650">[01_INPUT]</span> Analyze constraints, datasets, and systems parameters.</div>
              <div><span class="text-zinc-650">[02_MODELING]</span> Structure RAG data, select vectors (FAISS), and build architecture.</div>
              <div><span class="text-zinc-650">[03_DEV]</span> Develop logic backend (FastAPI/Python) and clean frontend client.</div>
              <div><span class="text-zinc-650">[04_TESTING]</span> Run full unit verification, validation checks, and latency audits.</div>
              <div><span class="text-zinc-650">[05_SHIPPING]</span> Containerize, deploy (Vercel/Local Ollama), and deliver live endpoints.</div>
            </div>

            <div class="flex items-center gap-1.5 mb-2 text-zinc-500">
              <span>onkar@terminal:~$</span>
              <span class="text-orange-400">syscheck --verify</span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-zinc-500 mb-6">
              <div>CLARITY: <span class="text-emerald-500">[OK]</span></div>
              <div>RESPONSIVE: <span class="text-emerald-500">[OK]</span></div>
              <div>MOTION: <span class="text-emerald-500">[OK]</span></div>
              <div>PERFORMANCE: <span class="text-emerald-500">[OK]</span></div>
            </div>
          </div>

          <div class="border-t border-zinc-800/40 pt-4 flex flex-col md:flex-row md:items-center justify-between gap-2 text-[10px] text-zinc-600">
            <div>STATUS: READY TO LAUNCH</div>
            <div class="text-orange-400/80">purpose + structure + clarity = impact</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Timeline Archive -->
    <div class="border-t border-zinc-800/20 pt-16 mb-24">
      <div class="flex flex-col gap-2 mb-12">
        <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">SYS: CHRONOLOGY</span>
        <h2 class="font-['Orbitron',sans-serif] text-base md:text-lg font-bold tracking-wider text-white">EDUCATION & PROFESSIONAL JOURNEY</h2>
      </div>

      <!-- Vertical Timeline -->
      <div class="relative pl-6 md:pl-8 border-l border-zinc-850 flex flex-col gap-12">
        {timeline.map((item) => (
          <div class="relative group">
            <div class="absolute -left-[31px] md:-left-[39px] top-1 w-2.5 h-2.5 rounded-full border border-zinc-800 bg-[#121218] group-hover:border-orange-500 transition-colors"></div>
            
            <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8">
              <span class="font-['Orbitron',sans-serif] text-xs font-bold text-orange-400 group-hover:text-orange-350 transition-colors select-none">
                {item.year}
              </span>
              <div class="flex flex-col gap-2">
                <h3 class="font-['Orbitron',sans-serif] text-xs font-bold tracking-wider text-white">
                  {item.title}
                </h3>
                <p class="text-zinc-550 text-xs leading-relaxed font-normal max-w-2xl">
                  {item.desc}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- System Stack -->
    <div class="border-t border-zinc-800/20 pt-16">
      <div class="flex flex-col gap-2 mb-12">
        <span class="text-[9px] font-bold tracking-[0.25em] text-zinc-500 uppercase">SYS: STACK</span>
        <h2 class="font-['Orbitron',sans-serif] text-base md:text-lg font-bold tracking-wider text-white">TOOLS BEHIND THE EXECUTION</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map((t) => (
          <div class="p-5 border border-zinc-800 bg-[#07070b] shadow-[0_4px_16px_rgba(0,0,0,0.5)] rounded flex items-center justify-between group hover:border-orange-500/20 transition-all duration-300">
            <div class="flex flex-col gap-1">
              <span class="font-['Orbitron',sans-serif] text-xs font-bold tracking-wider text-white">{t.name}</span>
              <span class="text-[8px] font-bold tracking-widest text-zinc-555 uppercase font-mono">{t.category}</span>
            </div>
            <span class="text-[9px] font-semibold text-zinc-500 border border-zinc-850 px-2 py-0.5 rounded group-hover:border-orange-500/10 group-hover:text-orange-400/80 transition-colors font-mono">
              {t.level}
            </span>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>
